<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="BlindVault"
           Manufacturer="BlindVault"
           Version="$(var.ProductVersion)"
           UpgradeCode="A9F4D2E1-7C3B-4E8A-9B6F-5D2C1E8A4F73"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="BlindVaultIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="BlindVaultIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/OmarAhmedTHE25th/BlindVault" />
    <Property Id="ARPHELPLINK" Value="https://github.com/OmarAhmedTHE25th/BlindVault" />

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="BlindVault" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="BlindVault" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainApplication" Title="BlindVault" Level="1">
      <Component Id="MainExecutable" Directory="INSTALLFOLDER">
        <File Id="BlindVaultGuiExe"
              Source="$(var.DistDir)\BlindVault_GUI.exe"
              KeyPath="yes" />
      </Component>

      <Files Include="$(var.DistDir)\**" Directory="INSTALLFOLDER">
        <Exclude Files="$(var.DistDir)\BlindVault_GUI.exe" />
      </Files>

      <Component Id="ApplicationShortcuts" Directory="ApplicationProgramsFolder">
        <Shortcut Id="StartMenuShortcut"
                  Name="BlindVault"
                  Description="BlindVault Zero-Knowledge RegTech Storage Gateway"
                  Target="[#BlindVaultGuiExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="BlindVaultIcon.ico" />
        <Shortcut Id="DesktopShortcut"
                  Directory="DesktopFolder"
                  Name="BlindVault"
                  Description="BlindVault Zero-Knowledge RegTech Storage Gateway"
                  Target="[#BlindVaultGuiExe]"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="BlindVaultIcon.ico" />
        <RemoveFolder Id="CleanUpStartMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\BlindVault"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </Feature>

  </Package>
</Wix>
